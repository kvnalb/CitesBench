{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/plan-before-risky.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python src/audit/build_manifest.py >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Regenerating MANIFEST.md"
          }
        ]
      }
    ]
  }
}
